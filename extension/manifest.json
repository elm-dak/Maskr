{
  "manifest_version": 3,
  "name": "Maskr — Redact images",
  "version": "0.1.0",
  "description": "Right-click any image on the web and redact it with Maskr. 100% in your browser — nothing is uploaded.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open Maskr" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://maskr.mestafa-wydad66.workers.dev/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
